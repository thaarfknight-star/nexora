{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexora",
  "version": "0.2.0",
  "identifier": "com.nexora.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nexora",
        "width": 760,
        "height": 440,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true
      },
      {
        "label": "settings",
        "title": "Nexora Settings",
        "width": 900,
        "height": 620,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "minWidth": 420,
        "minHeight": 480
      },
      {
        "label": "subtitle",
        "title": "Nexora Subtitles",
        "width": 820,
        "height": 128,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCMEZENDMxOEFFNjgxMDMKUldRRGdlYUtNZFFQKzAydWJkOFNLZ3NVWXRiZDh4Kyt3SUJ4QUh6N3hrZUE1ZVZGbGlhcTBIdlEK",
      "endpoints": [
        "https://github.com/thaarfknight-star/nexora/releases/download/update-feed/update-feed.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
